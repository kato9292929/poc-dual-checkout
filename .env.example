# 値はコミットしない。GitHub Actions では Secrets、Vercel では Environment Variables に置く。

# --- 販売ページの計測（Vercel 関数 api/track, api/stats） ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# api/stats を読むための Bearer トークン（集計スクリプトと共有）
STATS_TOKEN=

# --- 日次集計（scripts/collect-daily.mjs） ---
# 販売ページの計測値を取りに行く先（例: https://buy.jin.x402jp.com/api/stats）
STATS_URL=
# Solana RPC（未指定なら公開 RPC。レート制限が厳しいので専用 RPC 推奨）
SOLANA_RPC_URL=
# Stripe（Nevermined 経由のカード決済の入金先アカウントの制限付きキー。読み取り専用で可）
STRIPE_API_KEY=
# 実証1ゲートウェイの利用ログ出力（docs/card-source.md の形式）
GATEWAY_USAGE_URL=
GATEWAY_USAGE_TOKEN=
# トークンID・Stripe顧客IDを匿名化する HMAC 鍵
ANON_SALT=
