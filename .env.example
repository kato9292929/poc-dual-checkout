# 値はコミットしない。GitHub Actions では Secrets、Vercel では Environment Variables に置く。

# --- 販売ページの計測（Vercel 関数 api/track, api/stats） ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# api/stats を読むための Bearer トークン（集計スクリプトと共有）
STATS_TOKEN=

# --- 日次集計（scripts/collect-daily.mjs） ---
# 例: https://buy.jin.x402jp.com/api/stats
STATS_URL=
# Solana RPC（未指定なら公開 RPC。レート制限が厳しいので専用 RPC 推奨）
SOLANA_RPC_URL=
# Nevermined（売り手のキー。Events & Analytics は Premium 以上の組織でだけ使える）
NVM_API_KEY=
NVM_ORG_ID=
# Stripe Connect の接続アカウント（売り手）の制限付きキー。balance_transactions / payouts の読み取りだけ
STRIPE_API_KEY=
# 実証1ゲートウェイのログ（log/YYYY-MM-DD.jsonl）。どちらか一方
#   GATEWAY_LOG_DIR   ローカルのディレクトリ
#   GATEWAY_LOG_URL   {day} を UTC の日付に置き換えて GET する URL（例: https://gw.example/logs/{day}.jsonl）
GATEWAY_LOG_DIR=
GATEWAY_LOG_URL=
GATEWAY_LOG_TOKEN=
# Nevermined の userId・Stripe の取引 ID を匿名化する HMAC 鍵
ANON_SALT=

# --- 決済1件の所要時間の計測（scripts/probe-latency.mjs） ---
# 計測専用の新しい Solana ウォレット（base58 の 64 バイト秘密鍵）。少額の USDC だけ入れる。
# アドレスは config/exclusions.json の usdc_wallets に書く
PROBE_SOLANA_SECRET_KEY=
# 計測用の買い手のアクセストークン（実証1の npm run buyer:token で発行）。買い手は exclusions の card_buyers に書く
PROBE_NVM_ACCESS_TOKEN=
