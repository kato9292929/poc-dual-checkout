# 値はコミットしない。GitHub Actions では Secrets、Vercel では Environment Variables に置く。

# --- 販売ページの計測（Vercel 関数 api/track, api/stats） ---
# Vercel の Storage（Marketplace）で Upstash を足すと KV_REST_API_URL / KV_REST_API_TOKEN の名前で自動で入る。どちらの名前でも読む
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# api/stats を読むための Bearer トークン（集計スクリプトと共有）
STATS_TOKEN=

# --- 日次集計（scripts/collect-daily.mjs） ---
# 例: https://buy.jin.x402jp.com/api/stats
STATS_URL=
# Solana RPC（未指定なら公開 RPC。レート制限が厳しいので専用 RPC 推奨）
SOLANA_RPC_URL=
# 実証1ゲートウェイのログの口: GET {config/site.json の card.gateway_base_url}/logs/:date（:date は JST の日付）
# Bearer トークンは実証1の LOG_READ_TOKEN（読み取り専用）。カード払いの利用件数・消費クレジット・購入者はここで数える
LOG_READ_TOKEN=
# 口の URL を別にするときだけ。{day} を JST の日付に置き換える
# GATEWAY_LOG_URL=https://gw.example/logs/{day}
# （手元で試すとき）ローカルのディレクトリから読む
# GATEWAY_LOG_DIR=
# 売り手側の「エンドポイント ↔ tx 署名」ログ（docs/seller-log.md）。GET {SELLER_LOG_URL}/sales/:date（:date は JST の日付）
# JIN と OSD が受取口座を共有していて、$0.01 がどちらの商品かはこのログでしか分からない。無い日は unresolved のまま
SELLER_LOG_URL=
SELLER_LOG_TOKEN=
# Stripe（Nevermined の Stripe Connect の接続アカウント）の制限付き読み取り専用キー。手数料と着金日に使う
# 権限は Balance transactions・Payouts の Read だけ。未設定の日は stripe: "missing" になり、data/stripe/YYYY-MM.csv があればそれを読む
STRIPE_RESTRICTED_KEY=
# Nevermined（照合用。Events & Analytics は Premium 以上の組織でだけ使える。403 でも集計は止まらない）
NVM_API_KEY=
NVM_ORG_ID=
# Stripe の取引 ID を匿名化する HMAC 鍵
ANON_SALT=

# --- 決済1件の所要時間の計測（scripts/probe-latency.mjs） ---
# 計測専用の新しい Solana ウォレット（base58 の 64 バイト秘密鍵）。少額の USDC だけ入れる。
# アドレス（公開アドレスだけ）は config/own_wallets.json の solana に書く
PROBE_SOLANA_SECRET_KEY=
# カード払いの所要時間は実証1ゲートウェイのログの latencyMs を使うので、通常は不要（--only card で測るときだけ）
PROBE_NVM_ACCESS_TOKEN=
